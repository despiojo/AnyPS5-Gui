  <!-- Settings page -->
  <data name="Settings_Title.Text" xml:space="preserve"><value>Configuración</value></data>
  <data name="Settings_ComponentsHeader.Text" xml:space="preserve"><value>AnyPS5</value></data>
  <data name="Settings_ComponentsHelp.Text" xml:space="preserve"><value>El relinker y las bibliotecas del sistema para Windows se descargan de las versiones publicadas de AnyPS5 en GitHub. Al volver a convertir un juego, sus bibliotecas pasan a ser las de la versión en uso.</value></data>
  <data name="Settings_ActiveVersion.Header" xml:space="preserve"><value>Versión en uso</value></data>
  <data name="Settings_RemoveVersion.Content" xml:space="preserve"><value>Borrar esta versión</value></data>

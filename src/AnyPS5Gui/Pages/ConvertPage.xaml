<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnyPS5Gui.Pages.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AnyPS5Gui.Controls"
    xmlns:vm="using:AnyPS5Gui.ViewModels"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="24,20,24,12" Spacing="12" MaxWidth="1100">
                <TextBlock x:Uid="Convert_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="Convert_Intro" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Nothing to convert with yet -->
                <InfoBar x:Uid="Convert_ComponentsMissing" Severity="Warning" IsClosable="False"
                         IsOpen="{x:Bind ViewModel.Components.NeedsInstall, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="Convert_Download" Command="{x:Bind ViewModel.Components.InstallCommand}" />
                    </InfoBar.ActionButton>
                    <StackPanel Margin="0,0,24,14" Spacing="6"
                                Visibility="{x:Bind ViewModel.Components.HasDetails, Mode=OneWay}">
                        <ProgressBar Visibility="{x:Bind ViewModel.Components.IsBusy, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind ViewModel.Components.IsIndeterminate, Mode=OneWay}"
                                     Value="{x:Bind ViewModel.Components.Progress, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.Components.Status, Mode=OneWay}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Components.Error, Mode=OneWay}" TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.Components.HasError, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </InfoBar>

                <!-- Game -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="Convert_GamePath" Text="{x:Bind ViewModel.GamePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" x:Uid="Convert_BrowseFolder" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseGameFolderCommand}" />
                            <Button Grid.Column="2" x:Uid="Convert_BrowseFile" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseGameFileCommand}" />
                        </Grid>

                        <Grid ColumnSpacing="14" Visibility="{x:Bind ViewModel.HasGame, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="72" Height="72" CornerRadius="6" VerticalAlignment="Top"
                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Image Source="{x:Bind ViewModel.Icon, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.GameTitle, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.GameSubtitle, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.GameDetails, Mode=OneWay}"
                                           Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:IssueItem">
                                    <InfoBar IsOpen="True" IsClosable="False" Margin="0,0,0,4"
                                             Severity="{x:Bind Severity}" Message="{x:Bind Message}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Output -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="Convert_Output" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" x:Uid="Common_Browse" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseOutputCommand}" />
                        </Grid>

                        <CheckBox x:Uid="Convert_LinkFiles" IsChecked="{x:Bind ViewModel.LinkFiles, Mode=TwoWay}" />
                        <TextBlock x:Uid="Convert_LinkFilesHelp" Style="{StaticResource SecondaryTextStyle}" Margin="28,-6,0,4" />

                        <CheckBox x:Uid="Convert_ToIntel" IsChecked="{x:Bind ViewModel.ToIntel, Mode=TwoWay}" />
                        <TextBlock x:Uid="Convert_ToIntelHelp" Style="{StaticResource SecondaryTextStyle}" Margin="28,-6,0,4" />

                        <CheckBox x:Uid="Convert_WindowsGui" IsChecked="{x:Bind ViewModel.WindowsGui, Mode=TwoWay}" />
                        <TextBlock x:Uid="Convert_WindowsGuiHelp" Style="{StaticResource SecondaryTextStyle}" Margin="28,-6,0,0" />
                    </StackPanel>
                </Border>

                <Expander x:Uid="Convert_Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <ComboBox x:Uid="Convert_UnusedFilter" MinWidth="420"
                                  SelectedIndex="{x:Bind ViewModel.UnusedFilterIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Convert_UnusedFilter0" />
                            <ComboBoxItem x:Uid="Convert_UnusedFilter1" />
                            <ComboBoxItem x:Uid="Convert_UnusedFilter2" />
                        </ComboBox>

                        <StackPanel>
                            <CheckBox x:Uid="Convert_FrameRedZone" IsChecked="{x:Bind ViewModel.FrameRedZone, Mode=TwoWay}" />
                            <CheckBox x:Uid="Convert_WindowsDiagnostics" IsChecked="{x:Bind ViewModel.WindowsDiagnostics, Mode=TwoWay}" />
                            <CheckBox x:Uid="Convert_TraceImports" IsChecked="{x:Bind ViewModel.TraceImports, Mode=TwoWay}" />
                            <CheckBox x:Uid="Convert_Registry" IsChecked="{x:Bind ViewModel.Registry, Mode=TwoWay}" />
                            <CheckBox x:Uid="Convert_FunctionSymbolRoots" IsChecked="{x:Bind ViewModel.FunctionSymbolRoots, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBox x:Uid="Convert_FixedBase" Text="{x:Bind ViewModel.FixedBase, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Left" Width="420" />

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="Convert_SceModulePath" Text="{x:Bind ViewModel.SceModulePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" x:Uid="Common_Browse" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowseModuleParentCommand}" />
                        </Grid>

                        <TextBox x:Uid="Convert_ModuleDirectories" AcceptsReturn="True" MinHeight="64"
                                 Text="{x:Bind ViewModel.ModuleDirectories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox x:Uid="Convert_Executables" AcceptsReturn="True" MinHeight="64"
                                 Text="{x:Bind ViewModel.Executables, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox x:Uid="Convert_PatchMode" MinWidth="420"
                                  SelectedIndex="{x:Bind ViewModel.PatchModeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Convert_PatchAuto" />
                            <ComboBoxItem x:Uid="Convert_PatchNone" />
                            <ComboBoxItem x:Uid="Convert_PatchFromFile" />
                        </ComboBox>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Uid="Convert_PatchFile" Text="{x:Bind ViewModel.PatchFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{x:Bind ViewModel.PatchFileEnabled, Mode=OneWay}" />
                            <Button Grid.Column="1" x:Uid="Common_Browse" VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.BrowsePatchFileCommand}" />
                        </Grid>

                        <TextBox x:Uid="Convert_ExtraArguments" Text="{x:Bind ViewModel.ExtraArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Expander>

                <Expander x:Uid="Convert_CommandExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBlock Text="{x:Bind ViewModel.CommandPreview, Mode=OneWay}" Style="{StaticResource MonoTextStyle}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Padding="24,8,24,12" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.ResultOpen, Mode=TwoWay}"
                     Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Convert_ShowInGames" Command="{x:Bind ViewModel.ShowInGamesCommand}"
                            Visibility="{x:Bind ViewModel.CanShowInGames, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Uid="Convert_ConvertButton" Style="{StaticResource AccentButtonStyle}" MinWidth="120"
                        Command="{x:Bind ViewModel.ConvertCommand}" />
                <Button Grid.Column="1" x:Uid="Convert_DryRunButton" Command="{x:Bind ViewModel.DryRunCommand}" />
                <Button Grid.Column="2" x:Uid="Common_Cancel" Command="{x:Bind ViewModel.CancelCommand}" />
                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="4"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                                 Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <controls:LogView Grid.Row="2" Log="{x:Bind ViewModel.Log}" />
    </Grid>
</Page>

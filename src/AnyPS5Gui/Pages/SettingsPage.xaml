<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AnyPS5Gui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:AnyPS5Gui.Core.Components"
    xmlns:vm="using:AnyPS5Gui.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="24,20,24,24" Spacing="12" MaxWidth="1100">
            <TextBlock x:Uid="Settings_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- AnyPS5 itself -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="Settings_ComponentsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_ComponentsHelp" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Components.Summary, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8"
                                Visibility="{x:Bind ViewModel.Components.HasInstalled, Mode=OneWay}">
                        <ComboBox x:Name="InstalledBox" x:Uid="Settings_ActiveVersion" MinWidth="180"
                                  SelectionChanged="OnActiveVersionSelected"
                                  ItemsSource="{x:Bind ViewModel.Components.Installed}"
                                  SelectedItem="{x:Bind ViewModel.Components.ActiveVersion, Mode=OneWay}" />
                        <Button x:Uid="Settings_RemoveVersion" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.Components.RemoveActiveCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="ReleaseBox" x:Uid="Settings_Release" MinWidth="180"
                                  SelectionChanged="OnReleaseSelected"
                                  ItemsSource="{x:Bind ViewModel.Components.Releases}"
                                  SelectedItem="{x:Bind ViewModel.Components.SelectedRelease, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="components:ReleaseInfo">
                                    <TextBlock Text="{x:Bind Tag}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Uid="Settings_Check" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.Components.CheckCommand}" />
                        <Button x:Uid="Settings_Install" VerticalAlignment="Bottom" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.Components.InstallCommand}" />
                        <Button x:Uid="Common_Cancel" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.Components.CancelCommand}"
                                Visibility="{x:Bind ViewModel.Components.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <ProgressBar Visibility="{x:Bind ViewModel.Components.IsBusy, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.Components.IsIndeterminate, Mode=OneWay}"
                                 Value="{x:Bind ViewModel.Components.Progress, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.Components.Status, Mode=OneWay}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <InfoBar Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.Components.HasError, Mode=OneWay}"
                             Message="{x:Bind ViewModel.Components.Error, Mode=OneWay}" />

                    <StackPanel Spacing="2" Margin="0,8,0,0">
                        <TextBlock x:Uid="Settings_CustomHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Uid="Settings_CustomHelp" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="Settings_CustomRelinker" Text="{x:Bind ViewModel.CustomRelinkerPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" x:Uid="Common_Browse" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseRelinkerCommand}" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="Settings_CustomLibs" Text="{x:Bind ViewModel.CustomLibsPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" x:Uid="Common_Browse" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseLibsCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Where converted games go -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_FoldersHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Uid="Settings_OutputRoot" Text="{x:Bind ViewModel.OutputRoot, Mode=TwoWay}" />
                        <Button Grid.Column="1" x:Uid="Common_Browse" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.BrowseOutputRootCommand}" />
                    </Grid>
                    <TextBlock x:Uid="Settings_OutputRootHelp" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <!-- The text files of conversions and game runs -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_LogsHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Settings_LogsHelp" Style="{StaticResource SecondaryTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox x:Uid="Settings_LogsKeep" MinWidth="260" Minimum="0" Maximum="1000"
                                   SpinButtonPlacementMode="Inline"
                                   Value="{x:Bind ViewModel.LogFilesToKeep, Mode=TwoWay}" />
                        <Button x:Uid="Settings_LogsFolder" VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.OpenLogsFolderCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="Settings_AppearanceHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ComboBox x:Uid="Settings_Language" MinWidth="220"
                                  SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_LanguageSystem" />
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Español" />
                        </ComboBox>
                        <ComboBox x:Uid="Settings_Theme" MinWidth="220"
                                  SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="Settings_ThemeSystem" />
                            <ComboBoxItem x:Uid="Settings_ThemeLight" />
                            <ComboBoxItem x:Uid="Settings_ThemeDark" />
                        </ComboBox>
                    </StackPanel>
                    <InfoBar x:Uid="Settings_RestartNeeded" Severity="Informational" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.RestartNeeded, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Can this PC run converted games -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Settings_HostHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CpuName}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HostChecks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="18" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HostCheckItem">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" />
                                    <TextBlock Text="{x:Bind Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.HostSummary}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="AnyPS5 GUI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.Version}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Uid="Settings_AboutText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="-12,0,0,0">
                        <HyperlinkButton x:Uid="Settings_LinkProject" NavigateUri="https://github.com/boykopovar/AnyPS5" />
                        <HyperlinkButton x:Uid="Settings_LinkUsage" NavigateUri="https://github.com/boykopovar/AnyPS5/blob/main/docs/user/USAGE.md" />
                        <HyperlinkButton x:Uid="Settings_LinkInput" NavigateUri="https://github.com/boykopovar/AnyPS5/blob/main/docs/user/INPUT_MAPPING.md" />
                        <HyperlinkButton x:Uid="Settings_LinkCompatibility" NavigateUri="https://github.com/boykopovar/AnyPS5/discussions/categories/game-bring-up" />
                    </StackPanel>
                    <TextBlock x:Uid="Settings_Disclaimer" Style="{StaticResource SecondaryTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Uid="Settings_DataFolder" Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                        <TextBlock Text="{x:Bind ViewModel.DataFolder}" VerticalAlignment="Center"
                                   Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

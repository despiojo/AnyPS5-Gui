<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>AnyPS5Gui</RootNamespace>
    <AssemblyName>AnyPS5Gui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AnyPS5Gui.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- AnyPS5 runs games natively on x86-64, so that is the only architecture the app is built for. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- A plain folder with an exe: no MSIX, no installer, no .NET or Windows App SDK to install first. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnyPS5Gui.Core\AnyPS5Gui.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AnyPS5Gui.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
